.venv/
__pycache__/
*.py[cod]
# local data (incl. conflicts.db and raw GDELT downloads) — never commit
*.db
data/
.pytest_cache/
.ruff_cache/
.env
# UI smoke test deps (tests/ui)
tests/ui/node_modules/
# Chrome for Testing (installed via @puppeteer/browsers for chrome-devtools MCP)
chrome/
# local agent/assistant config (pi skills + extensions) — personal, not project
.agents/
.pi/

# Editor atomic-save temp files (draw.io desktop writes .$<name>.drawio.dtmp)
*.dtmp

# CI runner state (a self-hosted runner must never live in the repo:
# `actions/checkout` runs `git clean -ffdx` and would delete it)
actions-runner/
