        <mxCell id="note1" value="Dependency direction is one-way (build order): storage → ingestion → extraction → api → ui.&lt;br&gt;Extraction is the swappable source boundary — GDELT now, T5/LLM later via BaseSourceAdapter." style="text;html=1;align=left;verticalAlign=top;spacing=8;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" vertex="1" parent="1">
