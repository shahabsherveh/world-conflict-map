        <mxCell id="zero_shot" value="&lt;b&gt;ZeroShotConflictClassifier&lt;/b&gt;&lt;hr size=1&gt;- _pipeline (transformers, CPU)&lt;br&gt;- _labels = [armed conflict, not …]&lt;br&gt;+ classify(text, threshold)&lt;br&gt;+ classify_many(texts, threshold)&lt;br&gt;&lt;i&gt;batched, empty texts dropped&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="300" width="320" height="190" as="geometry" />
        </mxCell>
        <mxCell id="geocoder" value="&lt;b&gt;Geocoder&lt;/b&gt;&lt;hr size=1&gt;&lt;i&gt;«Protocol»&lt;/i&gt;&lt;br&gt;+ lookup(query) (lat, lon, country) | None" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="300" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="nominatim" value="&lt;b&gt;NominatimGeocoder&lt;/b&gt;&lt;hr size=1&gt;- min_interval = 1.1 s (rate limit)&lt;br&gt;+ lookup(query)&lt;br&gt;&lt;i&gt;repair only — off by default&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="460" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;GDELTClient&lt;/b&gt;&lt;hr size=1&gt;+ fifteen_minute_stamps(day): list[str]&lt;br&gt;+ download_export(ts): list[dict]&lt;br&gt;+ fetch_day(day): list[dict]&lt;br&gt;&lt;i&gt;404 skips a slot; 5xx fails the run&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
