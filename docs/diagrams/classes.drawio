<mxfile host="app.diagrams.net" agent="Global Conflict Map" version="24.0.0">
  <diagram id="classes" name="Classes">
    <mxGraphModel adaptiveColors="auto" dx="1900" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1800" math="0" shadow="0">
