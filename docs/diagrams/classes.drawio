        </mxCell>
        <mxCell id="single" value="&lt;b&gt;SingleTextClassifier&lt;/b&gt;&lt;hr size=1&gt;&lt;i&gt;«Protocol»&lt;/i&gt; — fallback&lt;br&gt;+ classify(text, threshold)&lt;br&gt;&amp;nbsp;&amp;nbsp;(bool, float)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="110" width="320" height="120" as="geometry" />
