        <mxCell id="e_assoc" value="1 — 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="conflict" target="conflict_event">
