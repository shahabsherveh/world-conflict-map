        <mxCell id="e_dto_creates" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1" source="event_dto" target="conflict_event">
