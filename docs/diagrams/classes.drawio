        </mxCell>
        <mxCell id="binary" value="&lt;b&gt;BinaryClassifier&lt;/b&gt;&lt;hr size=1&gt;&lt;i&gt;«Protocol»&lt;/i&gt; — fast path&lt;br&gt;+ classify_many(texts, threshold)&lt;br&gt;&amp;nbsp;&amp;nbsp;list[(bool, float)]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
