        <mxCell id="e_out_maps" value="serialises" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1" source="event_out" target="conflict_event">
          <mxGeometry relative="1" as="geometry" />
