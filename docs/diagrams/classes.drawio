        <mxCell id="gdelt_adapter" value="&lt;b&gt;GDELTAdapter&lt;/b&gt;&lt;hr size=1&gt;- ARMED_CONFLICT_ROOT_CODES = {18, 19, 20}&lt;br&gt;+ to_event_draft(raw): EventDraft | None&lt;br&gt;&amp;nbsp;&amp;nbsp;drops other root codes, bad SQLDATE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
