        <mxCell id="base" value="&lt;b&gt;BaseSourceAdapter&lt;/b&gt;&lt;hr size=1&gt;&lt;i&gt;«abstract»&lt;/i&gt;&lt;br&gt;+ to_event_draft(raw: dict)&lt;br&gt;&amp;nbsp;&amp;nbsp;EventDraft | None" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="draft" value="&lt;b&gt;EventDraft&lt;/b&gt;&lt;hr size=1&gt;&lt;i&gt;«dataclass»&lt;/i&gt; — no DB, no HTTP&lt;br&gt;+ source_event_id: str | None&lt;br&gt;+ place_name: str | None&lt;br&gt;+ country: str | None&lt;br&gt;+ lat / lon: float | None&lt;br&gt;+ event_date: date&lt;br&gt;+ event_type: str | None&lt;br&gt;+ actor_a / actor_b: str | None&lt;br&gt;+ fatalities: int | None&lt;br&gt;+ intensity: int&lt;br&gt;+ summary: str | None&lt;br&gt;+ source_url: str | None&lt;br&gt;+ confidence: float | None" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
