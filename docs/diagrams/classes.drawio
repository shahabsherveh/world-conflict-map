        <mxCell id="e_client_adapter" value="raw dicts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1" source="client" target="gdelt_adapter">
