        <mxCell id="conflict" value="&lt;b&gt;Conflict&lt;/b&gt;&lt;hr size=1&gt;+ id: int&lt;br&gt;+ name: str(255)&lt;br&gt;+ country: str | None&lt;br&gt;+ start_date: date&lt;br&gt;+ end_date: date | None&lt;br&gt;+ status: str&lt;br&gt;+ created_at / updated_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="750" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="conflict_event" value="&lt;b&gt;ConflictEvent&lt;/b&gt;&lt;hr size=1&gt;+ id: int&lt;br&gt;+ source_event_id: str | None «unique»&lt;br&gt;+ conflict_id: int | None «FK»&lt;br&gt;+ place_name / country&lt;br&gt;+ lat / lon: float | None&lt;br&gt;+ event_date: date&lt;br&gt;+ event_type: str | None&lt;br&gt;+ actor_a / actor_b&lt;br&gt;+ fatalities: int | None (always null)&lt;br&gt;+ intensity: int (1–5)&lt;br&gt;+ summary / source_url&lt;br&gt;+ confidence: float | None&lt;br&gt;+ provenance: auto | manual&lt;br&gt;&lt;i&gt;markers are per event — never re-positioned&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="750" width="320" height="440" as="geometry" />
        </mxCell>
        <mxCell id="raw_event" value="&lt;b&gt;RawEvent&lt;/b&gt;&lt;hr size=1&gt;+ id: int&lt;br&gt;+ source_event_id «unique»&lt;br&gt;+ source_day: date&lt;br&gt;+ event_date: date | None&lt;br&gt;+ event_root_code: str | None&lt;br&gt;+ source_file: str | None&lt;br&gt;+ payload: Text (JSON)&lt;br&gt;+ ingested_at / processed_at&lt;br&gt;+ outcome: persisted | duplicate |&lt;br&gt;&amp;nbsp;&amp;nbsp;filtered_out | not_armed_conflict&lt;br&gt;&lt;i&gt;written before extraction so a row replays&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="750" width="320" height="380" as="geometry" />
        </mxCell>
        <mxCell id="edit_log" value="&lt;b&gt;EditLog&lt;/b&gt;&lt;hr size=1&gt;+ id: int&lt;br&gt;+ target_type: event | conflict&lt;br&gt;+ target_id: int (polymorphic)&lt;br&gt;+ field: str&lt;br&gt;+ old_value / new_value: Text&lt;br&gt;+ edited_at: datetime" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="750" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="ingestion_run" value="&lt;b&gt;IngestionRun&lt;/b&gt;&lt;hr size=1&gt;+ id: int&lt;br&gt;+ source_day: date | None&lt;br&gt;+ mode: full | raw_only | backfill&lt;br&gt;+ phase: str | None&lt;br&gt;+ started_at / finished_at&lt;br&gt;+ status: running | success | failed&lt;br&gt;+ items_seen / items_new&lt;br&gt;+ error / degraded_reason: Text&lt;br&gt;&lt;i&gt;day rows and phase rows share the table;&lt;br&gt;phase names the whole-run step&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1480" y="750" width="320" height="380" as="geometry" />
        </mxCell>
        <mxCell id="conflict_out" value="&lt;b&gt;ConflictOut&lt;/b&gt;&lt;hr size=1&gt;id, name, country,&lt;br&gt;start_date, end_date, status" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="1310" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="summary" value="&lt;b&gt;ConflictSummary&lt;/b&gt; = ConflictOut +&lt;hr size=1&gt;+ intensity: int (max in range)&lt;br&gt;+ lat / lon (latest event)&lt;br&gt;+ event_count: int&lt;br&gt;+ headline: str | None" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="1310" width="280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="detail" value="&lt;b&gt;ConflictDetail&lt;/b&gt; = ConflictSummary +&lt;hr size=1&gt;+ events: list[ConflictEventOut]&lt;br&gt;&lt;i&gt;HEAD /api/conflicts/{id}&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="1310" width="280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="event_out" value="&lt;b&gt;ConflictEventOut&lt;/b&gt;&lt;hr size=1&gt;&lt;i&gt;«from_attributes»&lt;/i&gt; mirrors the row, plus&lt;br&gt;+ headline: str | None (URL slug)&lt;br&gt;+ created_at / updated_at&lt;br&gt;&lt;br&gt;&lt;i&gt;headline falls back to summary when the slug&lt;br&gt;is a bare article id&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1310" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="event_dto" value="&lt;b&gt;EventCreate&lt;/b&gt; / &lt;b&gt;EventUpdate&lt;/b&gt;&lt;hr size=1&gt;bounded to the stored columns:&lt;br&gt;place_name 255, country 120,&lt;br&gt;event_type 80, summary 5000,&lt;br&gt;source_url 1024 + http(s) check&lt;br&gt;lat/lon both-or-neither&lt;br&gt;&lt;i&gt;Update rejects nulling event_date,&lt;br&gt;intensity, and validates dates&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1310" width="340" height="240" as="geometry" />
        </mxCell>
